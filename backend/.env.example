# Aegis Backend Environment Variables
# Copy this file to .env and fill in your values

# LLM Provider: "gemini", "openai", "ollama", or "groq"
LLM_PROVIDER=gemini

# LLM Model name
LLM_MODEL=gemini-2.0-flash

# API Keys (fill in the one for your chosen provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Ollama (only if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Debug mode
DEBUG=false
